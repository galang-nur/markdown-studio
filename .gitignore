# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
#
# NOTE: this file is committed and is publicly visible on GitHub. That is by
# design — it is shared config. Never write the name of a real secret file in
# here; the name alone leaks it. For rules that must stay private, use
# .git/info/exclude instead, which is never pushed.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
desktop.ini

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — every variant is ignored. Keep a committed .env.example template
# so contributors know which variables exist, without the values.
.env
.env.*
!.env.example

# credentials & keys
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
id_rsa*
*.credentials.json
service-account*.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# AI assistant / agent tooling — local machine config, session state, and
# generated agent instructions. Nothing a person cloning the repo needs.
/.claude
/.cursor
/.aider*
/.mcp.json
CLAUDE.md
AGENTS.md
.github/copilot-instructions.md

# internal planning docs — kept local, not published.
# README.md is the only Markdown intentionally committed.
PRD_markdown_pdf_converter.md
PROGRESS.md

# editors
/.idea
/.vscode

# puppeteer's downloaded chromium (dev only; Docker uses the system one)
/.cache

# local scratch / generated output
/scratch
/tmp
*.local.*
