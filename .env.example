# Copy to .env.local for local overrides. .env* is gitignored; this template is not.
#
# The app is stateless and needs NO secrets — no database, no API keys, no auth.
# Everything below is optional and only affects how Puppeteer finds Chromium.

# Path to a Chromium/Chrome binary. Leave unset locally: Puppeteer downloads and
# uses its own. The Docker image sets this to the distro's Chromium.
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# Set to "true" ONLY inside a container. It drops Chromium's own sandbox, which
# is acceptable only because the container is already the isolation boundary and
# the process runs as an unprivileged user. Never set this on a bare host.
# PUPPETEER_NO_SANDBOX=true
